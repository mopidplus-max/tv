# SIMPLE IPTV — локальная конфигурация.
# Скопируйте файл в .env и измените значения при необходимости.

HOST=127.0.0.1
PORT=5000

# Секрет сессий. Если пусто — создаётся .secret_key автоматически.
SECRET_KEY=

# Скрытый адрес панели (обязательно со слешем на конце после нормализации).
ADMIN_PATH=/rJsyNeyajJAJjnsu/admin/

# Учётная запись администратора создаётся только при первом запуске.
ADMIN_USERNAME=YwyklHfx
ADMIN_PASSWORD=HsuahNItHIYFjY?!Jg@

# Сессии и защита от подбора.
SESSION_LIFETIME_MINUTES=60
ADMIN_SESSION_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# Пути (по умолчанию — внутри проекта).
STORAGE_DIR=
HLS_DIR=
LOG_DIR=
DATABASE_URL=

# Медиа-инструменты. По умолчанию используются tools/ffmpeg/*.exe.
FFMPEG_BIN=
FFPROBE_BIN=
YTDLP_ENABLED=true
FFMPEG_PROBE_TIMEOUT=40

# Выход HLS.
OUTPUT_WIDTH=1280
OUTPUT_HEIGHT=720
OUTPUT_FPS=30
VIDEO_BITRATE=2200k
AUDIO_BITRATE=128k
HLS_TIME=2
HLS_LIST_SIZE=10

# Публичный адрес для M3U/EPG. Пусто — из запроса.
PUBLIC_BASE_URL=

# Движок.
ENGINE_ENABLED=true
ENGINE_RETRIES=2
ENGINE_POLL_INTERVAL=0.5
LOG_LEVEL=INFO

# Лимиты загрузки.
MAX_CONTENT_LENGTH=2147483648
MAX_VIDEO_UPLOAD=1073741824
MAX_AUDIO_UPLOAD=209715200
MAX_IMAGE_UPLOAD=20971520
